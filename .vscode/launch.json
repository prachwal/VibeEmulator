{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Cli/bin/Debug/net10.0/vibe-emulator.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "CLI (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:release",
      "program": "${workspaceFolder}/src/Cli/bin/Release/net10.0/vibe-emulator.dll",
      "args": ["version"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
