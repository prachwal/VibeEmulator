{
  "version": "0.2.0",
  // Benchmarki (Bench, EmuBench, CycleModel) są w Release; pod debuggerem pomiary są
  // zniekształcone - do liczb używaj Ctrl+F5 (Run Without Debugging) albo zadań z terminala.
  "configurations": [
    {
      "name": "CLI (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Cli/bin/Debug/net10.0/vibe-emulator.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "CLI (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:release",
      "program": "${workspaceFolder}/src/Cli/bin/Release/net10.0/vibe-emulator.dll",
      "args": ["version"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "C64 Trace: demo",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tools/C64Trace/bin/Debug/net10.0/VibeEmulator.C64Trace.dll",
      "args": ["demo"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "C64 Trace: badline (okno kradzieży cykli)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tools/C64Trace/bin/Debug/net10.0/VibeEmulator.C64Trace.dll",
      "args": ["badline", "--from", "3030", "--to", "3060"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "C64 Trace: rmw (dwa zapisy)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tools/C64Trace/bin/Debug/net10.0/VibeEmulator.C64Trace.dll",
      "args": ["rmw", "--dump", "${workspaceFolder}/artifacts/trace-rmw.txt"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Bench: Fibonacci (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:release",
      "program": "${workspaceFolder}/tools/Bench/bin/Release/net10.0/VibeEmulator.Bench.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "EmuBench: cpu (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:release",
      "program": "${workspaceFolder}/tools/EmuBench/bin/Release/net10.0/VibeEmulator.EmuBench.dll",
      "args": ["cpu"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "CycleModel (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:release",
      "program": "${workspaceFolder}/tools/CycleModel/bin/Release/net10.0/VibeEmulator.CycleModel.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
