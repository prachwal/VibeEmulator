{
  // Auto-zatwierdzanie poleceń terminala to wygoda, nie granica bezpieczeństwa.
  // Celowo BRAK: "dotnet run" (uruchamia dowolny kod) i "dotnet add" (dodaje pakiety NuGet
  // bez przeglądu). Uwaga: "dotnet build"/"dotnet test" też wykonują kod z repo (analizatory,
  // zadania MSBuild, testy) - są tu świadomie, bo bez nich nie ma pętli edycja-test.
  // "dotnet format" obejmuje także "dotnet format --verify-no-changes".
  // Tracer C64 (skill c64-trace-debug): dozwolone tylko uruchomienie zbudowanej biblioteki
  // tools/C64Trace, zakotwiczonym wyrażeniem regularnym (dokumentacja VS Code opisuje klucze
  // /regex/, ale nie precyzuje dopasowania zwykłych kluczy). Wzorzec odrzuca --dump/-d (zapis
  // dowolnego pliku) oraz ;  &  |  <  >  `  $  ( ) w argumentach (łączenie poleceń, podstawienia).
  "chat.tools.terminal.autoApprove": {
    "dotnet sln": true,
    "dotnet build": true,
    "dotnet test": true,
    "dotnet format": true,
    "/^dotnet tools\\/C64Trace\\/bin\\/Release\\/net10\\.0\\/VibeEmulator\\.C64Trace\\.dll(?=\\s|$)(?!.*(?:--dump|\\s-d\\b))[^;&|<>`$()]*$/": true,
    "uniq": true,
    "printf": true,
    "awk": true,
    "dotnet tools/OpcodeInfo/bin/Release/net10.0/VibeEmulator.OpcodeInfo.dll": true,
    "time": true
  },
  "dotnet.defaultSolution": "VibeEmulator.slnx",
  "dotnet.server.useOmnisharp": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[json][jsonc][yaml][markdown]": {
    "editor.tabSize": 2
  },
  "testExplorer.useNativeTesting": true,
  // Instrukcje, prompty i hooki znajdują się w .github/.
  // Wspólne skille agentów znajdują się w .agents/skills/ (zob. AGENTS.md).
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  // Instrukcje dla funkcji AI edytora (tekst inline; zwykłe zdania, bez reguł z copilot-instructions.md).
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Wiadomość commita po polsku w formacie 'typ(zakres): opis' (Conventional Commits). Typy: feat, fix, refactor, test, docs, chore, ci, build. Zakresy: core, mos6502, memory, tools, mcp, vscode, copilot, plan. Temat w trybie rozkazującym do 72 znaków, bez kropki. W treści wyjaśnij dlaczego i jak zweryfikowano (liczby testów, wyniki wektorów)."
    }
  ],
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    {
      "text": "Opis PR po polsku: sekcje 'Co i dlaczego', 'Jak zweryfikowano' (build Debug i Release, testy, dotnet format, wektory SingleStepTests, pomiary wydajności jako minimum i mediana z wielu przebiegów) oraz 'Ryzyko'. Pisz wprost, czego nie uruchomiono."
    }
  ],
  "github.copilot.chat.reviewSelection.instructions": [
    {
      "text": "Recenzja kodu: wskaż błędy poprawności (cykle, flagi, dostęp do magistrali), regresje wydajności w gorącej ścieżce Tick, naruszenia kierunku zależności Memory/Mos6502/Core i brak testów. Zwróć listę uwag z lokalizacją; nie proponuj zmian poza zakresem."
    }
  ],
  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/BenchmarkDotNet.Artifacts": true
  }
}
