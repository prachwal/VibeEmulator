{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Build solution (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/VibeEmulator.slnx", "--nologo"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build:release",
      "detail": "Build solution (Release, optimized JIT)",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/VibeEmulator.slnx", "-c", "Release", "--nologo"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "detail": "Run all tests",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/VibeEmulator.slnx", "--nologo"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format",
      "detail": "Apply .editorconfig formatting and code style fixes",
      "type": "process",
      "command": "dotnet",
      "args": ["format", "${workspaceFolder}/VibeEmulator.slnx"],
      "problemMatcher": []
    },
    {
      "label": "format:verify",
      "detail": "Check formatting and code style without changing files",
      "type": "process",
      "command": "dotnet",
      "args": ["format", "${workspaceFolder}/VibeEmulator.slnx", "--verify-no-changes", "--severity", "warn"],
      "problemMatcher": []
    },
    {
      "label": "test:hooks",
      "detail": "Run Copilot hook regression tests (.github/hooks/test-*.sh)",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "rc=0; for t in .github/hooks/test-*.sh; do echo \"== $t\"; \"$t\" || rc=1; done; exit $rc"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "trace:demo",
      "detail": "Run C64Trace demo scenario (Release)",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "-c", "Release", "--project", "${workspaceFolder}/tools/C64Trace", "--", "demo"],
      "group": "none",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run:cli",
      "detail": "Run CLI with no arguments",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/Cli/VibeEmulator.Cli.csproj", "--"],
      "group": "none",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish:cli",
      "detail": "Publish CLI for linux-x64 (framework-dependent)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/Cli/VibeEmulator.Cli.csproj",
        "-c", "Release",
        "-r", "linux-x64",
        "--self-contained", "false",
        "-o", "${workspaceFolder}/artifacts/cli"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
