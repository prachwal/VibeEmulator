<Project>

  <!-- Wspólne ustawienia dla wszystkich projektów w solucji. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Każde ostrzeżenie kompilatora/analizatora łamie build (lokalnie i w CI). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Release: włączone optymalizacje JIT. NIE wyłączaj tieringu ani PGO.
       TieredCompilation/TieredPGO są domyślnie włączone w .NET 10; ustawienia poniżej
       są świadomą dokumentacją (chronią też przed nadpisaniem z zewnątrz). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Debug: pełne informacje diagnostyczne, bez optymalizacji. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Metadane pakietów NuGet (wspólne). Wersja może być nadpisana przez CI (-p:Version=...). -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>prachwal</Authors>
    <Company>prachwal</Company>
    <RepositoryUrl>https://github.com/prachwal/VibeEmulator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/prachwal/VibeEmulator</PackageProjectUrl>
    <PackageTags>emulator;6502;6510;c64;cpu</PackageTags>
  </PropertyGroup>

</Project>
