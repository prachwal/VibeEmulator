{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/copilot_adapter.py\" guard",
            "timeout": 15
          }
        ],
        "matcher": "^(Bash|apply_patch)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/copilot_adapter.py\" format",
            "timeout": 65
          }
        ],
        "matcher": "^(Bash|apply_patch)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/copilot_adapter.py\" verify",
            "timeout": 170
          }
        ]
      }
    ]
  }
}
