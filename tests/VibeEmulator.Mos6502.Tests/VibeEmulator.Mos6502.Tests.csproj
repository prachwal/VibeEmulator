<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- NETSDK1188: zasoby zh-hans/zh-hant w Microsoft.NET.Test.Sdk, nie nasz kod -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Memory\VibeEmulator.Memory.csproj" />
    <ProjectReference Include="..\..\src\Mos6502\VibeEmulator.Mos6502.csproj" />
    <!-- Etap L: logika harnessu obrazów jest testowana na syntetycznych obrazach. -->
    <ProjectReference Include="..\..\tools\CpuHarness\VibeEmulator.CpuHarness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Wektory SingleStepTests (MIT): czytane z dysku przez testy, bez sieci. -->
  <ItemGroup>
    <Content Include="Vectors\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
