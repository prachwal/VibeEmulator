{
    "$schema": "https://opencode.ai/config.json",
    // Migracja konfiguracji GitHub Copilot (.github) do OpenCode v2.
    "instructions": [
        ".github/copilot-instructions.md",
        ".github/instructions/*.instructions.md",
    ],
    "skills": [
        ".github/skills",
    ],
    "mcp": {
        "servers": {
            //   "obsidian": {
            //     "type": "local",
            //     "disabled": true,
            //     "command": [
            //       "sh",
            //       "-c",
            //       "cd \"$(git rev-parse --show-toplevel)\" && exec node tools/obsidian-mcp/server.js",
            //     ],
            //   },
        },
    },
    "formatter": {
        "csharp": {
            "command": [ "dotnet", "format", "VibeEmulator.slnx" ],
            "extensions": [ ".cs" ],
        },
    },
    "permissions": [
        { "action": "shell", "resource": "git push *", "effect": "ask" },
        { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
        { "action": "shell", "resource": "git clean *", "effect": "ask" },
        { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    ],
}
